generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Link {
  id          String   @id @default(cuid())
  originalUrl String
  slug        String   @unique
  createdAt   DateTime @default(now())
  expiresAt DateTime?
  userId      String
  clicks      Click[]
  user        User     @relation(fields: [userId], references: [id])
}

model Click {
  id        String   @id @default(cuid())
  linkId    String
  browser   String?
  device    String?
  country   String?
  createdAt DateTime @default(now())
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
}

model User {
  id    String @id @default(cuid())
  email String @unique
  links Link[]
}
